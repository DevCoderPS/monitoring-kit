# =====================================================================
#  ဒီဖိုင်ကို  .env  လို့ copy ကူးပြီး ဖြည့်ပါ   (.env ကို Git ထဲ မတင်ပါနဲ့)
#      Windows PowerShell :  Copy-Item .env.example .env
#      Linux / Mac        :  cp .env.example .env
#  တန်ဖိုးတွေမှာ quote ("...") မထည့်ပါနဲ့၊ တန်ဖိုးကြားမှာ space မထားပါနဲ့။
#
#  ပြင်ပြီးတိုင်း အောက်ကအတိုင်း up ကို ပြန် run ပါ (docker compose up -d ကို တိုက်ရိုက်မခေါ်ပါနဲ့):
#      Windows :  powershell -ExecutionPolicy Bypass -File scripts\up.ps1
#      Linux   :  bash scripts/up.sh
#
#  ဖွဲ့စည်းပုံ:
#      အပိုင်း ၁  အခြေခံ setting            (အားလုံး ဖြည့်ရမယ်)
#      အပိုင်း ၂  Alert ပို့မယ့်လမ်းကြောင်း     (Email / Telegram / စာပုံစံ)
#      အပိုင်း ၃  Optional feature          (လိုတာကိုပဲ ဖွင့်: App Metrics / Postgres / Uptime)
# =====================================================================


# #####################################################################
#  အပိုင်း ၁။ အခြေခံ setting
# #####################################################################

# ---- ၁.၁ ကြည့်မယ့်စက်ရဲ့ OS :  windows  သို့မဟုတ်  linux ----
# ဒါက Prometheus config၊ Alert rule၊ Host dashboard ကို OS အလိုက် ရွေးပေးတယ်။
# windows = Windows PC/Server (windows_exporter)
# linux = Linux server (node_exporter)
PLATFORM=windows

# ---- ၁.၂ စက်/ပတ်ဝန်းကျင် အမည် (log နဲ့ metric တိုင်းမှာ label အဖြစ် တပ်မယ်) ----
MONITORING_ENV=dev
MONITORING_HOST=my-pc

# ---- ၁.၃ App ရဲ့ log ဖိုင်တွေ ရှိတဲ့ folder ----
# ./logs = ဒီ kit folder ထဲက logs folder ။ တခြားနေရာဆိုရင် absolute path ပေးပါ။
# Windows ဥပမာ :  LOG_DIR=D:/MyProject/logs      (slash ကို / သုံးပါ)
# Linux ဥပမာ   :  LOG_DIR=/var/log/dtm-e-services   (folder ရှိပြီးသား ဖြစ်ရမယ်၊ Alloy ဖတ်ခွင့်ရှိရမယ်)
LOG_DIR=./logs

# ---- ၁.၄ Grafana login ----
GRAFANA_PORT=3000
GRAFANA_ADMIN_USER=admin
# အရှည်ကြီး ကိုယ်ပိုင် password ပေးပါ (ဒါကို မပြောင်းရင် မစတင်ပါဘူး)
GRAFANA_ADMIN_PASSWORD=


# #####################################################################
#  အပိုင်း ၂။ Alert ပို့မယ့်လမ်းကြောင်း
# #####################################################################

# ---- ၂.၁ ဘယ်လမ်းကြောင်းကို ဖွင့်မလဲ (true သို့မဟုတ် false) ----
# ဖွင့်ထားတာတွေကိုပဲ scripts/up က တပ်ပေးတယ်။ နှစ်ခုလုံး ဖွင့်လည်းရတယ်။
EMAIL_ALERT_ENABLE=true
TELEGRAM_ALERT_ENABLE=false

# ---- ၂.၂ Email  (EMAIL_ALERT_ENABLE=true ဆိုမှ ALERT_EMAIL, SMTP_* တွေ လိုတယ်) ----
# Alert တွေ လက်ခံမယ့် email (ကော်မာနဲ့ ခွဲပြီး တစ်ခုထက်ပိုလည်း ရတယ်)
ALERT_EMAIL=
# ပို့မယ့် Gmail အကောင့် (Gmail ကို SMTP သုံးမယ်ဆိုရင် App Password လိုတယ်)
#   App Password ယူရန် : https://myaccount.google.com/apppasswords (2-Step Verification ဖွင့်ထားရမယ်)
SMTP_ENABLED=true
SMTP_HOST=smtp.gmail.com:587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_FROM_NAME=Monitoring

# ---- ၂.၃ Telegram  (TELEGRAM_ALERT_ENABLE=true ဆိုမှ လိုတယ်) ----
#   1) Telegram မှာ @BotFather ကို /newbot ပို့ပြီး bot ဖန်တီး -> token ရမယ် (123456789:AAxxxx ပုံစံ)
#   2) ကိုယ့် bot ကို စာတစ်ကြောင်းပို့ (group ထဲပို့မယ်ဆို bot ကို group ထဲထည့်ပြီး စာရေး)
#   3) TELEGRAM_BOT_TOKEN ဖြည့်ပြီး  scripts/test-telegram  ကို run -> chat id ပြပေးမယ်
#   4) အဲဒီ chat id (group ဆိုရင် -100... လို အနှုတ်လက္ခဏာပါ) ကို TELEGRAM_CHAT_ID မှာ ဖြည့်
#   (token ကို မျှဝေမခံပါနဲ့၊ quote/space မထည့်ပါနဲ့)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ---- ၂.၄ Alert စာပုံစံ (Telegram/Email နှစ်ခုလုံးကို သက်ရောက်) ----
# true ဆိုရင် Alert စာကို kit ရဲ့ ပုံစံ (grafana/alerting/common/templates.yaml) နဲ့ ပို့မယ်။ ကိုယ်ပြင်လို့ရတယ်။
# false ဆိုရင် Grafana ရဲ့ မူလပုံစံ (ရှည်ပြီး အင်္ဂလိပ်လို) နဲ့ ပို့မယ်။
ALERT_TEMPLATE_ENABLE=true
# စာထဲက အချိန်ကို ဘယ် time zone နဲ့ ပြမလဲ (မြန်မာ = Asia/Yangon)။ စာထဲမှာ template error ပေါ်ရင် UTC လို့ ပြောင်းကြည့်ပါ။
ALERT_TIMEZONE=Asia/Yangon


# #####################################################################
#  အပိုင်း ၃။ Optional feature  (သုံးချင်တာကိုပဲ true လုပ်ပါ၊ မသုံးရင် false ထားပါ)
# #####################################################################

# ---- ၃.၁ DTM App Metrics (Spring Boot Actuator) ----
# true ဆိုရင် backend ရဲ့ request/JVM/DB pool Dashboard + Alert ၄ ခု ဖွင့်မယ်။
# Backend ဘက်မှာ dependency + setting ထည့်ပြီးမှ (README ၅.၁ ကိုကြည့်) true လုပ်ပါ။
APP_METRICS_ENABLE=false
# backend ကို container ထဲကနေ ခေါ်မယ့်လိပ်စာ (backend ကို Windows/Linux host ပေါ်မှာ run ထားရင် ဒီအတိုင်း)
APP_METRICS_TARGET=host.docker.internal:8080
APP_METRICS_PATH=/actuator/prometheus
# Staging/Prod ပြင်ပ server ကို ချိတ်ရင် (README ၅.၁.၁ ကိုကြည့်):
#   https နဲ့ ချိတ်ချင်ရင် https  (မဖြည့်ရင် http)
APP_METRICS_SCHEME=http
#   nginx မှာ basic auth ကာထားရင် user/password ဖြည့် (နှစ်ခုလုံး ဖြည့်၊ သို့မဟုတ် နှစ်ခုလုံး ဗလာ)
#   password မှာ space နဲ့ " ' $ # \ မထည့်ပါနဲ့
APP_METRICS_USER=
APP_METRICS_PASSWORD=

# ---- ၃.၂ Postgres monitoring ----
# true ဆိုရင် Postgres dashboard + Alert ၄ ခု ဖွင့်မယ် (postgres-exporter container ကို အလိုအလျောက် တပ်မယ်)။
# monitor သီးသန့် user (pg_monitor role) ဆောက်ပြီးမှ true လုပ်ပါ (README ၅.၂ ကိုကြည့်)။
POSTGRES_ENABLE=false
# Postgres ကို host စက်ပေါ်မှာ run ထားရင် host.docker.internal အတိုင်း ထားပါ
POSTGRES_HOST=host.docker.internal
POSTGRES_PORT=5432
POSTGRES_DB=postgres
POSTGRES_USER=
# password မှာ space နဲ့ " ' $ # \ မထည့်ပါနဲ့ (monitoring သီးသန့် password ပေးပါ)
POSTGRES_PASSWORD=
# Staging/Prod မှာ SSL သုံးရင် require လို့ပြောင်း
POSTGRES_SSLMODE=disable

# ---- ၃.၃ Uptime check (URL စစ်ခြင်း) ----
# true ဆိုရင် URL တွေကို ၁၅ စက္ကန့်တစ်ခါ အပြင်ကနေ ခေါ်ကြည့်ပြီး Uptime dashboard + Alert ၂ ခု (URL down / HTTPS cert ၁၄ ရက်အတွင်းကုန်) ဖွင့်မယ်။
UPTIME_ENABLE=false
# စစ်ချင်တဲ့ URL တွေ၊ comma (,) နဲ့ ခြား။ http:// သို့ https:// နဲ့ စရမယ်။
# localhost / 127.0.0.1 ရေးရင် host စက်ကို ညွှန်းအောင် အလိုအလျောက် ပြောင်းပေးတယ်။
# ဥပမာ: UPTIME_URLS=http://localhost:8080/actuator/health,https://dtm.gov.mm
UPTIME_URLS=
