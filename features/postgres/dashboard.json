{
 "title": "DTM Postgres",
 "uid": "dtm-postgres",
 "schemaVersion": 39,
 "version": 1,
 "tags": [
  "database",
  "postgres"
 ],
 "time": {
  "from": "now-1h",
  "to": "now"
 },
 "refresh": "30s",
 "editable": true,
 "panels": [
  {
   "id": 1,
   "type": "stat",
   "title": "Postgres up",
   "gridPos": {
    "x": 0,
    "y": 0,
    "w": 4,
    "h": 4
   },
   "datasource": {
    "type": "prometheus",
    "uid": "dtm-prometheus"
   },
   "targets": [
    {
     "refId": "A",
     "expr": "max(pg_up) or vector(0)",
     "datasource": {
      "type": "prometheus",
      "uid": "dtm-prometheus"
     },
     "instant": true
    }
   ],
   "fieldConfig": {
    "defaults": {
     "mappings": [
      {
       "type": "value",
       "options": {
        "0": {
         "text": "DOWN",
         "color": "red"
        },
        "1": {
         "text": "UP",
         "color": "green"
        }
       }
      }
     ],
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "red",
        "value": null
       },
       {
        "color": "green",
        "value": 1
       }
      ]
     }
    },
    "overrides": []
   },
   "options": {
    "colorMode": "background"
   }
  },
  {
   "id": 2,
   "type": "gauge",
   "title": "Connections used",
   "gridPos": {
    "x": 4,
    "y": 0,
    "w": 5,
    "h": 4
   },
   "datasource": {
    "type": "prometheus",
    "uid": "dtm-prometheus"
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum(pg_stat_activity_count) / max(pg_settings_max_connections) * 100",
     "datasource": {
      "type": "prometheus",
      "uid": "dtm-prometheus"
     },
     "instant": true
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "percent",
     "min": 0,
     "max": 100,
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "green",
        "value": null
       },
       {
        "color": "orange",
        "value": 70
       },
       {
        "color": "red",
        "value": 90
       }
      ]
     }
    },
    "overrides": []
   }
  },
  {
   "id": 3,
   "type": "stat",
   "title": "Database size",
   "gridPos": {
    "x": 9,
    "y": 0,
    "w": 5,
    "h": 4
   },
   "datasource": {
    "type": "prometheus",
    "uid": "dtm-prometheus"
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum(pg_database_size_bytes{datname!~\"template.*|postgres\"})",
     "datasource": {
      "type": "prometheus",
      "uid": "dtm-prometheus"
     },
     "instant": true
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "bytes"
    },
    "overrides": []
   }
  },
  {
   "id": 4,
   "type": "stat",
   "title": "Longest running transaction",
   "gridPos": {
    "x": 14,
    "y": 0,
    "w": 5,
    "h": 4
   },
   "datasource": {
    "type": "prometheus",
    "uid": "dtm-prometheus"
   },
   "targets": [
    {
     "refId": "A",
     "expr": "max(pg_stat_activity_max_tx_duration)",
     "datasource": {
      "type": "prometheus",
      "uid": "dtm-prometheus"
     },
     "instant": true
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "s",
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "green",
        "value": null
       },
       {
        "color": "orange",
        "value": 300
       },
       {
        "color": "red",
        "value": 600
       }
      ]
     }
    },
    "overrides": []
   }
  },
  {
   "id": 5,
   "type": "stat",
   "title": "Deadlocks (last 1h)",
   "gridPos": {
    "x": 19,
    "y": 0,
    "w": 5,
    "h": 4
   },
   "datasource": {
    "type": "prometheus",
    "uid": "dtm-prometheus"
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum(increase(pg_stat_database_deadlocks[1h]))",
     "datasource": {
      "type": "prometheus",
      "uid": "dtm-prometheus"
     },
     "instant": true
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "short",
     "decimals": 0,
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "green",
        "value": null
       },
       {
        "color": "red",
        "value": 1
       }
      ]
     }
    },
    "overrides": []
   }
  },
  {
   "id": 6,
   "type": "timeseries",
   "title": "Connections by state",
   "gridPos": {
    "x": 0,
    "y": 4,
    "w": 12,
    "h": 8
   },
   "datasource": {
    "type": "prometheus",
    "uid": "dtm-prometheus"
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum by (state) (pg_stat_activity_count{state!~\"disabled|fastpath function call\"})",
     "datasource": {
      "type": "prometheus",
      "uid": "dtm-prometheus"
     },
     "legendFormat": "{{state}}"
    },
    {
     "refId": "B",
     "expr": "max(pg_settings_max_connections)",
     "datasource": {
      "type": "prometheus",
      "uid": "dtm-prometheus"
     },
     "legendFormat": "max_connections"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "short"
    },
    "overrides": []
   }
  },
  {
   "id": 7,
   "type": "timeseries",
   "title": "Transactions per second",
   "gridPos": {
    "x": 12,
    "y": 4,
    "w": 12,
    "h": 8
   },
   "datasource": {
    "type": "prometheus",
    "uid": "dtm-prometheus"
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum(rate(pg_stat_database_xact_commit[1m]))",
     "datasource": {
      "type": "prometheus",
      "uid": "dtm-prometheus"
     },
     "legendFormat": "commit"
    },
    {
     "refId": "B",
     "expr": "sum(rate(pg_stat_database_xact_rollback[1m]))",
     "datasource": {
      "type": "prometheus",
      "uid": "dtm-prometheus"
     },
     "legendFormat": "rollback"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "ops"
    },
    "overrides": []
   }
  },
  {
   "id": 8,
   "type": "timeseries",
   "title": "Cache hit ratio",
   "gridPos": {
    "x": 0,
    "y": 12,
    "w": 12,
    "h": 8
   },
   "datasource": {
    "type": "prometheus",
    "uid": "dtm-prometheus"
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum(rate(pg_stat_database_blks_hit[5m])) / clamp_min(sum(rate(pg_stat_database_blks_hit[5m])) + sum(rate(pg_stat_database_blks_read[5m])), 1) * 100",
     "datasource": {
      "type": "prometheus",
      "uid": "dtm-prometheus"
     },
     "legendFormat": "hit %"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "percent",
     "min": 0,
     "max": 100
    },
    "overrides": []
   }
  },
  {
   "id": 9,
   "type": "timeseries",
   "title": "Rows per second",
   "gridPos": {
    "x": 12,
    "y": 12,
    "w": 12,
    "h": 8
   },
   "datasource": {
    "type": "prometheus",
    "uid": "dtm-prometheus"
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum(rate(pg_stat_database_tup_inserted[1m]))",
     "datasource": {
      "type": "prometheus",
      "uid": "dtm-prometheus"
     },
     "legendFormat": "inserted"
    },
    {
     "refId": "B",
     "expr": "sum(rate(pg_stat_database_tup_updated[1m]))",
     "datasource": {
      "type": "prometheus",
      "uid": "dtm-prometheus"
     },
     "legendFormat": "updated"
    },
    {
     "refId": "C",
     "expr": "sum(rate(pg_stat_database_tup_deleted[1m]))",
     "datasource": {
      "type": "prometheus",
      "uid": "dtm-prometheus"
     },
     "legendFormat": "deleted"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "ops"
    },
    "overrides": []
   }
  },
  {
   "id": 10,
   "type": "timeseries",
   "title": "Database size over time",
   "gridPos": {
    "x": 0,
    "y": 20,
    "w": 12,
    "h": 8
   },
   "datasource": {
    "type": "prometheus",
    "uid": "dtm-prometheus"
   },
   "targets": [
    {
     "refId": "A",
     "expr": "pg_database_size_bytes{datname!~\"template.*|postgres\"}",
     "datasource": {
      "type": "prometheus",
      "uid": "dtm-prometheus"
     },
     "legendFormat": "{{datname}}"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "bytes"
    },
    "overrides": []
   }
  },
  {
   "id": 11,
   "type": "timeseries",
   "title": "Locks by mode",
   "gridPos": {
    "x": 12,
    "y": 20,
    "w": 12,
    "h": 8
   },
   "datasource": {
    "type": "prometheus",
    "uid": "dtm-prometheus"
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum by (mode) (pg_locks_count)",
     "datasource": {
      "type": "prometheus",
      "uid": "dtm-prometheus"
     },
     "legendFormat": "{{mode}}"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "short"
    },
    "overrides": []
   }
  },
  {
   "id": 12,
   "type": "timeseries",
   "title": "Dead tuples (tables needing vacuum)",
   "gridPos": {
    "x": 0,
    "y": 28,
    "w": 24,
    "h": 8
   },
   "datasource": {
    "type": "prometheus",
    "uid": "dtm-prometheus"
   },
   "targets": [
    {
     "refId": "A",
     "expr": "topk(10, pg_stat_user_tables_n_dead_tup)",
     "datasource": {
      "type": "prometheus",
      "uid": "dtm-prometheus"
     },
     "legendFormat": "{{schemaname}}.{{relname}}"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "short"
    },
    "overrides": []
   }
  }
 ]
}