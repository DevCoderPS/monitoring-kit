{
  "title": "Application Logs",
  "uid": "dtm-app-logs",
  "schemaVersion": 39,
  "version": 1,
  "tags": [
    "logs"
  ],
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "refresh": "30s",
  "editable": true,
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "ERROR count (selected time range)",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 6,
        "h": 5
      },
      "datasource": {
        "type": "loki",
        "uid": "dtm-loki"
      },
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(count_over_time({level=\"ERROR\"}[$__range])) or vector(0)",
          "queryType": "instant",
          "datasource": {
            "type": "loki",
            "uid": "dtm-loki"
          }
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Log lines per level (per minute)",
      "gridPos": {
        "x": 6,
        "y": 0,
        "w": 18,
        "h": 8
      },
      "datasource": {
        "type": "loki",
        "uid": "dtm-loki"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (level) (count_over_time({service=~\".+\"}[1m]))",
          "legendFormat": "{{level}}",
          "datasource": {
            "type": "loki",
            "uid": "dtm-loki"
          }
        }
      ]
    },
    {
      "id": 3,
      "type": "logs",
      "title": "WARN / ERROR logs",
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 24,
        "h": 10
      },
      "datasource": {
        "type": "loki",
        "uid": "dtm-loki"
      },
      "options": {
        "showTime": true,
        "wrapLogMessage": true,
        "sortOrder": "Descending",
        "enableLogDetails": true
      },
      "targets": [
        {
          "refId": "A",
          "expr": "{level=~\"WARN|ERROR\"}",
          "queryType": "range",
          "datasource": {
            "type": "loki",
            "uid": "dtm-loki"
          }
        }
      ]
    },
    {
      "id": 4,
      "type": "logs",
      "title": "All logs",
      "gridPos": {
        "x": 0,
        "y": 18,
        "w": 24,
        "h": 12
      },
      "datasource": {
        "type": "loki",
        "uid": "dtm-loki"
      },
      "options": {
        "showTime": true,
        "wrapLogMessage": true,
        "sortOrder": "Descending",
        "enableLogDetails": true
      },
      "targets": [
        {
          "refId": "A",
          "expr": "{service=~\".+\"}",
          "queryType": "range",
          "datasource": {
            "type": "loki",
            "uid": "dtm-loki"
          }
        }
      ]
    }
  ]
}